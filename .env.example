# Variáveis opcionais. Sem elas o site funciona inteiro — apenas sem medição.
# Copie para `.env.local` no desenvolvimento; em produção, defina no build
# (GitHub → Settings → Secrets and variables → Actions → Variables).

# Tag do Google Analytics 4 / Google Ads. Ex.: G-XXXXXXXXXX ou AW-XXXXXXXXX
VITE_GTAG_ID=

# Sentry. Sem DSN, o pacote sequer é baixado pelo navegador.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
