{
  "name": "kyottosushi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site do Kyotto Sushi — sushi delivery em Senador Canedo (GO)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "check:dev": "node scripts/check-dev.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "assets": "node scripts/optimize-images.mjs",
    "brand": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/make-brand.mjs",
    "cardapio:conferir": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/conferir-cardapio.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@sentry/react": "^10.76.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
